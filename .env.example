# -------------------------------------------------------------
# Biến môi trường mẫu cho Đồ án 2D sang 3D AI (Nhóm ae cây khế)
# Sao chép file này thành .env và điền thông tin tương ứng.
# LƯU Ý: Tuyệt đối không commit file .env chứa token lên GitHub!
# -------------------------------------------------------------

# Hugging Face Access Token cá nhân (Loại token: Read)
# Đăng ký và lấy token miễn phí tại: https://huggingface.co/settings/tokens
HF_TOKEN=

# Hugging Face Space ID chạy mô hình TRELLIS (mặc định của Microsoft)
HF_SPACE_ID=microsoft/TRELLIS

# Chế độ Mock Mode giả lập:
# Đặt 'true' để test cục bộ khi mất mạng hoặc Space bị nghẽn; đặt 'false' để chạy AI thật
MOCK_MODE=false
